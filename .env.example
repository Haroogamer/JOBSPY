# Fill these in on the machine that runs the cron. Never commit this file.
# All keys are free. Leave blank to skip that source.

# Discord alerts (required for notifications)
# Create: Discord channel settings -> Integrations -> Webhooks -> New Webhook
DISCORD_WEBHOOK_URL=

# Adzuna — broadest US commercial coverage. Free: https://developer.adzuna.com/signup
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# USAJobs — federal ServiceNow roles. Free key: https://api.data.gov/signup/
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# Jobicy needs no key (keyless, remote-only).

# Source toggles (1 = on, 0 = off). Defaults when unset:
#   indeed_jobspy ON (primary), ats_boards OFF, workday OFF, free_apis ON.
# Uncomment to override:
#SOURCE_INDEED_JOBSPY=1
#SOURCE_ATS_BOARDS=0
#SOURCE_WORKDAY=0
#SOURCE_FREE_APIS=1

# Hunter.io — company email pattern lookup for hiring-manager outreach.
# Free: https://hunter.io (25 domain searches/month; one per company, cached forever).
HUNTER_API_KEY=
